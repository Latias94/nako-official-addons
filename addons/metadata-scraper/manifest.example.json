{
  "id": "nako.official.metadata-scraper",
  "name": "Nako Metadata Scraper",
  "version": "0.1.0-alpha.2",
  "protocol_version": "0.1.0-alpha.1",
  "base_url": "http://nako-metadata-scraper:9100",
  "description": "Official Nako metadata scraper sidecar. It returns metadata suggestions and can submit explicit Nako-owned metadata/artwork side effects when configured.",
  "resources": [
    {
      "kind": "metadata",
      "path": "/metadata",
      "input_schema": "nako.metadata.request.v1",
      "output_schema": "nako.metadata.response.v1",
      "required_scopes": ["item_metadata_read", "item_metadata_suggest"],
      "timeout_ms": 10000,
      "max_attempts": 2
    }
  ],
  "entry_points": [
    {
      "id": "metadata-diagnostics",
      "kind": "diagnostics",
      "label": "Metadata Scraper Diagnostics",
      "path": "/ui/diagnostics",
      "hosted_page_id": "diagnostics",
      "required_scopes": ["item_metadata_read"]
    }
  ],
  "hosted_pages": [
    {
      "id": "diagnostics",
      "title": "Metadata Scraper Diagnostics",
      "path": "/ui/diagnostics",
      "required_scopes": ["item_metadata_read"]
    }
  ],
  "configuration_schema": {
    "schema_id": "nako.official.metadata-scraper.config.v1",
    "schema": {
      "type": "object",
      "properties": {
        "preferred_language": { "type": "string", "default": "en-US" },
        "providers": {
          "type": "object",
        "properties": {
          "fixture": { "type": "boolean", "default": true },
          "tmdb": { "type": "boolean", "default": false },
          "bangumi": { "type": "boolean", "default": false },
          "browser_worker": { "type": "boolean", "default": false },
          "douban": { "type": "boolean", "default": false }
        },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "secret_reference_fields": [],
  "event_subscriptions": [
    {
      "id": "library-scanned",
      "event_kind": "library.scanned",
      "path": "/events/library-scanned",
      "required_scopes": ["webhook_event_read"],
      "filters": null
    }
  ],
  "tasks": [
    {
      "id": "bulk-metadata-scrape",
      "name": "Bulk metadata scrape",
      "path": "/tasks/bulk-metadata-scrape",
      "description": "Runs metadata suggestions for a bounded batch of items",
      "required_scopes": ["automation_run"],
      "timeout_ms": 30000,
      "max_attempts": 2
    }
  ],
  "auth": "none",
  "default_timeout_ms": 10000,
  "default_max_attempts": 2,
  "scopes": ["item_metadata_read", "item_metadata_suggest", "automation_run", "webhook_event_read"]
}
